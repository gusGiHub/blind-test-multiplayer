# URL used in the browser and registered in the Spotify dashboard.
APP_URL=http://127.0.0.1:3000
# Public Client ID from Spotify for Developers. PKCE requires no Client Secret.
SPOTIFY_CLIENT_ID=
# Production: configure APP_URL=https://your-service.onrender.com in the host dashboard.
# Register APP_URL + /api/spotify/callback in Spotify for Developers.
# PORT is supplied by the host (defaults to 3000 locally).
