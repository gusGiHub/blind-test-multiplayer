# URL used in the browser and registered in the Spotify dashboard.
APP_URL=http://127.0.0.1:3000
# Public Client ID from Spotify for Developers. PKCE requires no Client Secret.
SPOTIFY_CLIENT_ID=
# Vercel production: APP_URL=https://blind-test-multiplayer.vercel.app
# Shared PostgreSQL storage. Leave empty for local in-memory development.
SUPABASE_URL=
# Backend secret key (sb_secret_...). NEVER use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT also works via SUPABASE_SERVICE_ROLE_KEY.
# Run supabase/migrations/202611190001_game_state.sql before deploying.
DATABASE_STATE_NAMESPACE=production
# Production: configure these values in the host dashboard, not only .env.local.
# Register APP_URL + /api/spotify/callback in Spotify for Developers.
# PORT is supplied by the host (defaults to 3000 locally).
