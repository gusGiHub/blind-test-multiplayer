{
  "name": "blind-test-multiplayer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --exclude .next server.ts",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "node start.mjs",
    "lint": "eslint",
    "test:spotify": "node --test tests/spotify.test.mjs",
    "test:game": "node --test tests/gameEngine.test.mjs tests/gameFlow.test.mjs tests/gameLobby.test.mjs",
    "test": "node --test tests/gameEngine.test.mjs tests/gameFlow.test.mjs tests/gameLobby.test.mjs tests/spotify.test.mjs tests/serverConfig.test.mjs",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
